# ---------------------------------------------------------------------------
# Public site URL
# ---------------------------------------------------------------------------
# Used for canonical links, Open Graph tags, the sitemap and robots.txt.
# Set this to your production origin (no trailing slash) before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Development previews (optional, dev server only)
# ---------------------------------------------------------------------------
# While running `next dev`, Next.js blocks cross-origin /_next/* requests. If
# you preview the site through a tunnel or hosted preview (Codespaces, Cloud
# preview, ngrok), list those hostnames here, comma-separated. Ignored in
# production builds.
# Example: NEXT_ALLOWED_DEV_ORIGINS=my-preview.example.dev,abc.ngrok.app
NEXT_ALLOWED_DEV_ORIGINS=

# ---------------------------------------------------------------------------
# Reservation delivery (optional)
# ---------------------------------------------------------------------------
# Reservations are validated server-side and then logged. To forward them
# somewhere real — Slack, Discord, Zapier, Make, a CRM, Resend, etc. — paste
# an HTTPS webhook URL here. The server posts the validated reservation as
# JSON to this endpoint. Leave empty to keep reservation logging only.
#
# Slack:   https://hooks.slack.com/services/...
# Discord: https://discord.com/api/webhooks/...
# Zapier:  https://hooks.zapier.com/hooks/catch/...
RESERVATION_WEBHOOK_URL=
